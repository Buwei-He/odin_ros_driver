<launch>
    <!--
        Copy of odin1_ros1.launch with pcd2depth_node's publish_rgbd enabled
        (aligned color + camera_info, for a DAAAM-style consumer).

        Usage: roslaunch odin_ros_driver odin1_ros1_rgbd.launch
    -->

    <!-- Set node name -->
    <arg name="node_name" default="host_sdk_sample"/>

    <!-- Set parameter file path -->
    <arg name="config_file" default="$(find odin_ros_driver)/config/control_command.yaml"/>

    <!-- Set RViz configuration file path -->
    <arg name="rviz_config" default="$(find odin_ros_driver)/config/odin_ros.rviz"/>

    <!-- cloud_reprojection_node/image_overlay_node/rviz exist only to produce and
         show a visualization overlay: nothing downstream (DAAAM, ros1_stream_sender)
         consumes their topics. Default true preserves existing interactive/dev
         behavior; set false for a headless robot deploy to save the CPU/GPU they'd
         otherwise burn for no consumer. -->
    <arg name="visualize" default="true"/>

    <!-- Launch main node -->
    <node name="$(arg node_name)" pkg="odin_ros_driver" type="host_sdk_sample" output="screen">
        <param name="config_file" value="$(arg config_file)"/>
    </node>

    <node pkg="odin_ros_driver" type="pcd2depth_node" name="pcd2depth_node" output="screen" >
        <rosparam command="load" file="$(find odin_ros_driver)/config/control_command.yaml"/>
        <!-- calib_file_path left unset: node falls back to the shared runtime dir (~/.ros/odin_ros_driver/calib.yaml) -->
        <!-- register_keys/senddepth is the actual gate pcd2depth_node checks before doing
             anything (see pcd2depth_ros.cpp): control_command.yaml ships it 0, so it must
             be overridden here or this node exits immediately and publish_rgbd is never reached -->
        <param name="register_keys/senddepth" value="1"/>
        <param name="publish_rgbd" value="true"/>
    </node>

    <group if="$(arg visualize)">
        <node pkg="odin_ros_driver" type="cloud_reprojection_node" name="cloud_reprojection_node" output="screen" >
            <rosparam command="load" file="$(find odin_ros_driver)/config/control_command.yaml"/>
            <!-- calib_file_path left unset: node falls back to the shared runtime dir (~/.ros/odin_ros_driver/calib.yaml) -->
        </node>

        <!-- Image overlay node - overlays reprojected points on camera image -->
        <node pkg="odin_ros_driver" type="image_overlay_node" name="image_overlay_node" output="screen" >
            <rosparam command="load" file="$(find odin_ros_driver)/config/control_command.yaml"/>
        </node>

        <!-- Launch RViz with configuration -->
        <node name="rviz" pkg="rviz" type="rviz" args="-d $(arg rviz_config)" output="screen"/>
    </group>
</launch>
